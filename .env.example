# ============================================================================
# SHOPMATE AAAS ENTERPRISE CONFIGURATION
# ============================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
# For local fallback, leave empty or use sqlite+aiosqlite:///./data/aaas_enterprise.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/aaas_enterprise
POSTGRES_DB=aaas_enterprise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Python AI & RAG Backend
PYTHON_BACKEND_URL=http://127.0.0.1:8000
PORT=3000

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=super-secret-enterprise-jwt-token-key-32chars
AUTH_COOKIE_NAME=aaas_auth_token
NODE_ENV=development
